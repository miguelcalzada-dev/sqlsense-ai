# ============================================================
# SQLSense AI - Variables de entorno (opcionales)
# Copia este archivo a .env.local y rellena tus valores reales.
# ============================================================

# Clave de OpenAI. Si no se define, la app usa el motor local
# basado en patrones y la demo sigue siendo funcional.
OPENAI_API_KEY=

# Modelo a usar (por defecto gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Rate limit de las API routes de IA (protege la cuota de OpenAI).
# Maximo de peticiones por IP dentro de la ventana.
AI_RATE_LIMIT_MAX=20
# Ventana en milisegundos.
AI_RATE_LIMIT_WINDOW_MS=60000

# URL del binario SQLite WASM. Por defecto se sirve localmente
# desde /sqlsense/sql-wasm.wasm (public/). Solo es necesario
# definirla para apuntar a otro origen.
# NEXT_PUBLIC_SQL_WASM_URL=/sqlsense/sql-wasm.wasm
